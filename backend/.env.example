# Backend settings. Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored: private values stay on your computer and never go to GitHub.
# Lines marked REQUIRED must be set or the backend will not start.

# --- Database ---
# REQUIRED. Your MongoDB connection string (ask the team lead for the Atlas one).
#   Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#   Local: mongodb://localhost:27017
MONGO_URI=
MONGO_DB=crop_guardian_db
# Load backend/crop_profiles.json into the crops collection when it is empty (true/false)
SEED_CROPS=true

# --- Login / admin ---
# REQUIRED. Long random string (at least 32 characters) that signs login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRE_DAYS=30
# REQUIRED. Admin phone numbers, comma-separated. 03000000001 is the demo admin created by scripts/seed.py.
ADMIN_PHONES=03000000001
# REQUIRED. Secret word (at least 8 characters) admins type in the "Admin Key" field when logging in.
ADMIN_KEY=

# --- HTTP ---
# Frontend URLs allowed to call the API (comma-separated). Add your deployed frontend URL here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_PREDICT_PER_MIN=30

# --- AI model ---
# Path to the trained model (relative to backend/). Without it, diagnosis runs in demo mode.
MODEL_PATH=crop_model.pt
# Below this confidence (0-1) the photo is reported as "Unrecognized Image"
CONFIDENCE_THRESHOLD=0.5
MAX_UPLOAD_MB=5
