# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# MongoDB: local server, or your Atlas connection string (mongodb+srv://USER:PASSWORD@cluster.../)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=crop_guardian_db

# Long random string used to sign login tokens. If empty, a temporary one is used and everyone is logged out on restart.
JWT_SECRET=

# Admins: comma-separated phone numbers, plus the key they type in the "Admin key" field when logging in.
ADMIN_PHONES=03001234567
ADMIN_KEY=

# Frontend URLs allowed to call the API (comma-separated). Add your Vercel URL when deployed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI model (optional). Without the file or torch installed, /api/predict runs in clearly labelled demo mode.
MODEL_PATH=crop_model.pt
CONFIDENCE_THRESHOLD=0.5
MAX_UPLOAD_MB=5
