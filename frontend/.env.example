# Frontend settings. Copy this file to frontend/.env and fill in the values.
# frontend/.env is gitignored. Nothing here is secret, but keep the same pattern as the backend.

# Development: where `npm run dev` forwards /api calls (your local backend).
API_PROXY_TARGET=http://127.0.0.1:8000

# Production build only (e.g. Vercel): full backend URL ending in /api.
# Leave empty for local development so the dev proxy above is used.
VITE_API_URL=
